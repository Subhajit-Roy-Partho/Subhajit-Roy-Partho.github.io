# Public flags (safe to expose; NEXT_PUBLIC_ only for non-secrets).
# GitHub Pages static build: NEXT_PUBLIC_ENABLE_DB=0
# Vercel dynamic build:      NEXT_PUBLIC_ENABLE_DB=1
NEXT_PUBLIC_ENABLE_DB=0
# Local dev only. Production builds (Vercel + Pages) must point at the live
# site — lib/env.ts defaults to it when this is unset, and the Pages workflow
# pins it explicitly. Never ship localhost here in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Analytics: same measurement ID on both deploys. The code default in
# app/layout.tsx already carries it; set this env to the SAME value on Vercel
# and in the Pages workflow to override/pin it explicitly.
NEXT_PUBLIC_GA_ID=G-X8WMNMXDWQ

# --- Vercel-only (never NEXT_PUBLIC_, never commit real values) ---
# Turso
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
# better-auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32-min-32-chars
# Vercel production MUST be the stable alias (never localhost) — the server
# throws on a localhost baseURL in production (see lib/auth.ts).
BETTER_AUTH_URL=https://subhajit-roy-partho-github-io-subhajit-roys-projects.vercel.app
# Public mirror of the above for client-side absolute links (nav "Sign in ↗",
# DbPlaceholder, apibank LiveLinks). Set to the SAME alias on Vercel.
NEXT_PUBLIC_SITE_URL=https://subhajit-roy-partho-github-io-subhajit-roys-projects.vercel.app
# OAuth (optional; social buttons hidden when unset)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Vault: 32 random bytes, base64 (openssl rand -base64 32)
VAULT_ENCRYPTION_KEY_B64=
